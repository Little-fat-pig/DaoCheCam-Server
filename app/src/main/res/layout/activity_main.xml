<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <!-- 全屏摄像头预览（开始服务后显示） -->
    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 全屏时的顶部覆盖条：整条可点=复制地址，右侧停止 -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#66000000"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_copy_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="等待地址…"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:ellipsize="middle"
            android:padding="10dp"
            android:background="#44000000" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="110dp"
            android:text="停止"
            android:layout_marginLeft="10dp" />
    </LinearLayout>

    <!-- 开始前的设置面板（运行时整个隐藏，不挡画面不挡触摸） -->
    <ScrollView
        android:id="@+id/scroll_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tv_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未在运行"
                android:textSize="14sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tv_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1a73e8"
                android:paddingTop="6dp"
                android:visibility="gone"
                android:textIsSelectable="true" />

            <LinearLayout
                android:id="@+id/panel_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="4dp">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content"
                        android:text="摄像头" android:textSize="15sp" android:gravity="center_vertical"/>
                    <Spinner android:id="@+id/sp_cam" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="4dp">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content"
                        android:text="分辨率" android:textSize="15sp" android:gravity="center_vertical"/>
                    <Spinner android:id="@+id/sp_res" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="4dp">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content"
                        android:text="画面旋转" android:textSize="15sp" android:gravity="center_vertical"/>
                    <Spinner android:id="@+id/sp_rot" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="4dp">
                    <TextView android:layout_width="90dp" android:layout_height="wrap_content"
                        android:text="画质" android:textSize="15sp" android:gravity="center_vertical"/>
                    <Spinner android:id="@+id/sp_q" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="开始服务" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
